{
  // Static site: Cloudflare serves ./dist directly, no Worker code runs.
  "name": "baz-bz",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Served only on the real domain; www is redirected to it by a zone redirect rule.
  "routes": [{ "pattern": "baz.bz", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
